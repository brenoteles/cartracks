<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/settings_auto_tracking_title">

    <PreferenceCategory android:title="@string/settings_auto_tracking_title">
        <SwitchPreferenceCompat
            android:defaultValue="@bool/settings_auto_start_power_default"
            android:key="@string/settings_auto_start_power_key"
            android:summary="@string/settings_auto_power_connected_summary"
            android:title="@string/settings_auto_power_connected_title" />

        <SwitchPreferenceCompat
            android:defaultValue="@bool/settings_auto_stop_power_default"
            android:key="@string/settings_auto_stop_power_key"
            android:summary="@string/settings_auto_power_disconnected_summary"
            android:title="@string/settings_auto_power_disconnected_title" />

        <SwitchPreferenceCompat
            android:defaultValue="@bool/settings_auto_start_bluetooth_default"
            android:key="@string/settings_auto_start_bluetooth_key"
            android:summary="@string/settings_auto_bluetooth_summary"
            android:title="@string/settings_auto_bluetooth_title" />
    </PreferenceCategory>

</PreferenceScreen>