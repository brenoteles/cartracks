<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Card Principal: Dashboard do Carro -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="#20000000"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_activity_drive_24dp"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Resumo da Garagem"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Car Tracker"
                    app:chipMinHeight="28dp" />
            </LinearLayout>

            <!-- Grid de Indicadores Automotivos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Km Rodados"
                        android:textSize="12sp"
                        android:alpha="0.7" />
                    <TextView
                        android:id="@+id/dash_total_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96.6 km"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combustível Est."
                        android:textSize="12sp"
                        android:alpha="0.7" />
                    <TextView
                        android:id="@+id/dash_fuel_spent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.7 L (R$ 45,35)"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Média Consumo"
                        android:textSize="12sp"
                        android:alpha="0.7" />
                    <TextView
                        android:id="@+id/dash_fuel_avg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.5 km/L"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20000000"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Destinos Frequentes & Posto Mais Utilizado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dash_top_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Destino mais frequente: Escritório Paulista (45% das viagens)"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dash_top_gas_station"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="⛽ Posto mais abastecido: Shell Jardins (65% dos abastecimentos)"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="Histórico de Viagens Gravadas"
        android:textSize="14sp"
        android:textStyle="bold"
        android:alpha="0.8" />

</LinearLayout>