<?xml version="1.0" encoding="utf-8"?>
<!-- Painel: trip state (timer while recording, tank and range when parked) and the start/stop band. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bebas_neue_regular"
            android:text="CARTRACKS"
            android:textColor="#E8FF3A"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono_semibold"
            android:letterSpacing="0.1"
            android:text="ESTACIONADO"
            android:textColor="#BDC1A3"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_tank_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tank_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/ibm_plex_mono_semibold"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="TANQUE"
                android:textColor="#8E9270"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_tank_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_mono_bold"
                android:text="—"
                android:textColor="#F3F5E6"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_tank_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_tank_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_timer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/ibm_plex_mono_semibold"
            android:letterSpacing="0.1"
            android:text="TEMPO"
            android:textColor="#8E9270"
            android:textSize="10sp" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono_bold"
            android:textColor="#F3F5E6"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#E8FF3A"
        android:fontFamily="@font/bebas_neue_regular"
        android:gravity="center"
        android:minHeight="40dp"
        android:text="▶  INICIAR VIAGEM"
        android:textColor="#0C0C14"
        android:textSize="22sp" />
</LinearLayout>
