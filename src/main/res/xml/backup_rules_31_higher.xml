<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Google Drive / Google One) and device-to-device transfer.
     Trips/fuel databases, preferences (vehicle, consumption, maintenance) and the rotating JSON
     backups; the MapLibre tile cache is left out. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
